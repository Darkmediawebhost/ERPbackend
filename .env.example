# Copy to .env in this folder. The API reads it on startup.

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/darkmediaerp
JWT_SECRET=replace-with-a-long-random-string

# Development sign-in is refused in production even if this is true.
ALLOW_DEV_AUTH=true
DEV_LOGIN_PASSWORD=DarkMedia@2026

# The only Gmail allowed to open the app.
LOGIN_EMAIL=darkmediatech4@gmail.com

# Founder profile emails. These are not extra logins.
FOUNDER_SAJEEL_EMAIL=sajeel@darkmedia.local
FOUNDER_SHAKEEB_EMAIL=shakeeb@darkmedia.local
FOUNDER_ISMAIL_EMAIL=ismail@darkmedia.local

# Google Cloud OAuth client ID. This is not a Firebase key.
GOOGLE_CLIENT_ID=

# Gmail code and invoice email. SMTP_PASS is a Google App Password, not the Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=darkmediatech4@gmail.com
SMTP_PASS=
SMTP_FROM=DARK MEDIA <darkmediatech4@gmail.com>

TRUST_PROXY=false
